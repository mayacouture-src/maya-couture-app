# Caddy écoute en HTTP simple sur :80 dans le conteneur (mappé sur
# 127.0.0.1:8080 de l'hôte). Pas de TLS ici — c'est `tailscale serve` qui
# termine le HTTPS sur le tailnet avec un vrai certificat Let's Encrypt
# pour le domaine *.ts.net.
:80 {
    encode zstd gzip

    # Photos servies depuis MinIO
    handle_path /media/* {
        rewrite * /maya-photos{uri}
        reverse_proxy minio:9000
    }

    # App Next.js
    reverse_proxy app:3000
}
